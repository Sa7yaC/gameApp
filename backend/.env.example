# Additional comma-separated frontend origins (the production game origin is always allowed).
CORS_ALLOWED_ORIGINS=https://emojicharades.fun

# Set DATABASE_URL to a managed PostgreSQL connection string. TLS with certificate
# verification is enabled automatically unless PG_SSL=false is explicitly set.
# For separate PG_HOST/PG_PORT/PG_USER/PG_PASSWORD/PG_DATABASE settings, set PG_SSL=true
# when the database requires TLS (such as an external Render PostgreSQL connection).
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=verify-full
PG_SSL=true

# Optional Redis configuration. Leave both unset to use in-memory storage.
# For a deployed/multi-instance backend, configure REDIS_URL with your managed Redis URL.
# REDIS_URL=redis://localhost:6379
# Or use REDIS_HOST and REDIS_PORT for a local Redis server:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

