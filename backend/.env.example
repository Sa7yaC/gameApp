# Additional comma-separated frontend origins (the production game origin is always allowed).
CORS_ALLOWED_ORIGINS=https://emojicharades.fun

# Optional Redis configuration. Leave both unset to use in-memory storage.
# For a deployed/multi-instance backend, configure REDIS_URL with your managed Redis URL.
# REDIS_URL=redis://localhost:6379
# Or use REDIS_HOST and REDIS_PORT for a local Redis server:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

